    <%part2 rhythm2/textinput(3) octave2/knob velocity2/knob>(62)
    <%part3 rhythm3/textinput(3) octave3/knob velocity3/knob>(62)
    [%controls
      <bpm/knob chordduration/knob zoom/knob>(80)
