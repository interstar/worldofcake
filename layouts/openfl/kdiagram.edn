{:generator-version 1
 :application {:id "kdiagram" :package "kdiagram" :generated-package "generated.kdiagram"
               :composition-kind :worldofcake-components
               :composition-class "KDiagramCompositionGenerated"
               :layout-class "KDiagramLayoutGenerated"
               :sequencer-class "KDiagramSequencer" :view-class "KDiagramView"}
 ;; The play area is square: the network lives in -1..1 on both axes.
 :geometry {:panel-width 856.0 :panel-height 640.0
            :outer-padding 6.0 :root-gap 6.0 :nested-gap 6.0}
 ;; Each cursor's position as continuous controls (0..1): X and Y on that cursor's MIDI channel.
 ;; Hosts present each as a MIDI CC, a VST parameter and Rack CV. The channel selector moves them.
 :outputs [{:id "red-x" :label "Red X" :channel 1 :cc 1}
           {:id "red-y" :label "Red Y" :channel 1 :cc 2}
           {:id "green-x" :label "Green X" :channel 2 :cc 1}
           {:id "green-y" :label "Green Y" :channel 2 :cc 2}
           {:id "blue-x" :label "Blue X" :channel 3 :cc 1}
           {:id "blue-y" :label "Blue Y" :channel 3 :cc 2}]
 :components
 {"playarea" {:kind :play-area
              :local-min-x -1.0 :local-min-y 1.0 :local-max-x 1.0 :local-max-y -1.0}

  ;; One box per cursor, holding its controls; the heading names the column.
  "speed-heading" {:kind :text :text "Speed"}
  "red" {:kind :box :fill "0xD4473D" :fill-alpha 0.16 :border "0xD4473D" :border-alpha 0.55 :padding 6.0}
  "green" {:kind :box :fill "0x2F9A48" :fill-alpha 0.16 :border "0x2F9A48" :border-alpha 0.55 :padding 6.0}
  "blue" {:kind :box :fill "0x3A74D0" :fill-alpha 0.16 :border "0x3A74D0" :border-alpha 0.55 :padding 6.0}
  "redspeed" {:kind :knob :minimum 0.05 :maximum 8.0 :default 0.5 :mapping :logarithmic :unit :units-per-second :output :midi-note
              :label "Red speed" :show-label false :colour "0xD4473D" :view-hook "addValueControl"}
  "greenspeed" {:kind :knob :minimum 0.05 :maximum 8.0 :default 0.5 :mapping :logarithmic :unit :units-per-second :output :midi-note
                :label "Green speed" :show-label false :colour "0x2F9A48" :view-hook "addValueControl"}
  "bluespeed" {:kind :knob :minimum 0.05 :maximum 8.0 :default 0.5 :mapping :logarithmic :unit :units-per-second :output :midi-note
               :label "Blue speed" :show-label false :colour "0x3A74D0" :view-hook "addValueControl"}

  "controls" {:kind :box :fill "0xFFFFFF" :border "0xD9DCE1" :padding 8.0}
  "selectcursor" {:kind :semantic-select :label "Cursor" :tooltip "Cursor that clicks in the play area move." :default-index 0 :presentation "segmented" :view-hook "setCursorSelect"
                  :choices [{:value 0 :label "R" :colour "0xD4473D"}
                            {:value 1 :label "G" :colour "0x2F9A48"}
                            {:value 2 :label "B" :colour "0x3A74D0"}]}
  "scaleselect" {:kind :semantic-select :label "Scale" :default-index 0 :presentation "compact" :view-hook "setScaleSelect"
                 :choices [{:value 0 :label "Chromatic" :colour "0x606874"}
                           {:value 1 :label "Major" :colour "0x606874"}
                           {:value 2 :label "Minor" :colour "0x606874"}
                           {:value 3 :label "Harm minor" :colour "0x606874"}
                           {:value 4 :label "Mel minor" :colour "0x606874"}
                           {:value 5 :label "Min blues" :colour "0x606874"}]}
  ;; The cursors play on three consecutive MIDI channels starting here.
  "channel" {:kind :semantic-select :label "MIDI channels" :tooltip "The red, green and blue cursors use three consecutive MIDI channels from here."
             :default-index 0 :presentation "compact" :view-hook "setChannelSelect"
             :choices [{:value 1 :label "Ch 1-3"} {:value 2 :label "Ch 2-4"} {:value 3 :label "Ch 3-5"} {:value 4 :label "Ch 4-6"}
                       {:value 5 :label "Ch 5-7"} {:value 6 :label "Ch 6-8"} {:value 7 :label "Ch 7-9"} {:value 8 :label "Ch 8-10"}
                       {:value 9 :label "Ch 9-11"} {:value 10 :label "Ch 10-12"} {:value 11 :label "Ch 11-13"} {:value 12 :label "Ch 12-14"}
                       {:value 13 :label "Ch 13-15"} {:value 14 :label "Ch 14-16"}]}
  "note-length-heading" {:kind :text :text "Note length"}
  "note-length" {:kind :knob :minimum 0.005 :maximum 2.0 :default 0.05 :mapping :logarithmic :unit :seconds :output :midi-note
                 :label "Note length" :short-label "Len" :show-label false :tooltip "Time from each note-on to its note-off."
                 :colour "0x5A616D" :view-hook "addValueControl"}
  "reset" {:kind :button :label "Reset" :icon :reset :colour "0x3A3F48"}
  "pause" {:kind :toggle :label "Pause" :icon :pause :default false :colour "0x3A3F48"}
  "rotate-left" {:kind :button :label "Rotate left" :icon :rotate-ccw :colour "0x3A3F48"}
  "rotate-right" {:kind :button :label "Rotate right" :icon :rotate-cw :colour "0x3A3F48"}}}
