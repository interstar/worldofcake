{:generator-version 1
 :application {:id "goldenpond"
               :package "goldenpond"
               :generated-package "generated.goldenpond"
               :composition-kind :worldofcake-components
               :sequencer-class "GoldenpondSequencer"
               :view-class "GoldenpondView"
               :composition-class "GoldenpondCompositionGenerated"
               :layout-class "GoldenpondLayoutGenerated"}
 :geometry {:panel-width 1400.0
            :panel-height 580.0
            :outer-padding 6.0
            :root-gap 6.0
            :nested-gap 6.0}
 :components
 {"playarea" {:kind :play-area
               :local-min-x 0.0 :local-min-y 0.0
               :local-max-x 760.0 :local-max-y 600.0
               :view-hook "setPlayArea"}

  ;; Harmony: what is played.
  "harmony" {:kind :box :fill "0xFFFFFF" :border "0xD9DCE1" :padding 8.0}
  "chordinput" {:kind :text-input :default "" :label "Chord progression"}
  "keyselect" {:kind :semantic-select :label "Key" :tooltip "Root note for the generated score." :default-index 0 :unit :pitch-class :output :midi-note :presentation "compact"
               :view-hook "setKeySelect"
               :choices [{:value 0 :label "C"} {:value 1 :label "C#"}
                         {:value 2 :label "D"} {:value 3 :label "Eb"}
                         {:value 4 :label "E"} {:value 5 :label "F"}
                         {:value 6 :label "F#"} {:value 7 :label "G"}
                         {:value 8 :label "Ab"} {:value 9 :label "A"}
                         {:value 10 :label "Bb"} {:value 11 :label "B"}]}
  "modeselect" {:kind :semantic-select :label "Scale" :tooltip "Scale or mode used to generate and correct notes." :default-index 0 :unit :scale :output :midi-note :presentation "compact"
                :view-hook "setModeSelect"
                :choices [{:value 0 :label "Major"}
                          {:value 1 :label "Minor"}
                          {:value 2 :label "Harmonic minor"}
                          {:value 3 :label "Melodic minor"}
                          {:value 4 :label "Harmonic major"}
                          {:value 5 :label "Hungarian minor"}
                          {:value 6 :label "Double harmonic"}]}
  "correctiontarget" {:kind :semantic-select :label "Correction target" :tooltip "How incoming keyboard notes are corrected." :default-index 0 :presentation "compact"
                       :view-hook "setCorrectionTargetSelect"
                       :choices [{:value 0 :label "Scale" :colour "0x40C0FF"}
                                 {:value 1 :label "Key pentatonic" :colour "0xD49A55"}
                                 {:value 2 :label "Chord tones" :colour "0xD43C3C"}
                                 {:value 3 :label "Chord pentatonic" :colour "0x9ACB7C"}]}

  ;; One box per part, in that part's piano-roll note colour. The headings name the columns.
  "rhythm-heading" {:kind :text :text "Rhythm"}
  "octave-heading" {:kind :text :text "Octave"}
  "velocity-heading" {:kind :text :text "Velocity"}
  "part0" {:kind :box :fill "0x55B7D9" :fill-alpha 0.16 :border "0x55B7D9" :border-alpha 0.55 :padding 6.0}
  "part1" {:kind :box :fill "0xE56B6F" :fill-alpha 0.16 :border "0xE56B6F" :border-alpha 0.55 :padding 6.0}
  "part2" {:kind :box :fill "0x76B947" :fill-alpha 0.16 :border "0x76B947" :border-alpha 0.55 :padding 6.0}
  "part3" {:kind :box :fill "0xC58BE8" :fill-alpha 0.16 :border "0xC58BE8" :border-alpha 0.55 :padding 6.0}
  "rhythm0" {:kind :text-input :default "" :label "Part 1 rhythm"}
  "rhythm1" {:kind :text-input :default "" :label "Part 2 rhythm"}
  "rhythm2" {:kind :text-input :default "" :label "Part 3 rhythm"}
  "rhythm3" {:kind :text-input :default "" :label "Part 4 rhythm"}
  "octave0" {:kind :knob :minimum -3.0 :maximum 3.0 :default 0.0 :unit :octave :output :midi-note
             :label "Part 1 octave" :short-label "Oct" :show-label false :colour "0x55B7D9" :view-hook "addValueControl"}
  "octave1" {:kind :knob :minimum -3.0 :maximum 3.0 :default 0.0 :unit :octave :output :midi-note
             :label "Part 2 octave" :short-label "Oct" :show-label false :colour "0xE56B6F" :view-hook "addValueControl"}
  "octave2" {:kind :knob :minimum -3.0 :maximum 3.0 :default 0.0 :unit :octave :output :midi-note
             :label "Part 3 octave" :short-label "Oct" :show-label false :colour "0x76B947" :view-hook "addValueControl"}
  "octave3" {:kind :knob :minimum -3.0 :maximum 3.0 :default 0.0 :unit :octave :output :midi-note
             :label "Part 4 octave" :short-label "Oct" :show-label false :colour "0xC58BE8" :view-hook "addValueControl"}
  "velocity0" {:kind :knob :minimum 0.0 :maximum 127.0 :default 100.0 :unit :midi-velocity :output :midi-note
               :label "Part 1 velocity" :short-label "Vel" :show-label false :colour "0x55B7D9" :view-hook "addValueControl"}
  "velocity1" {:kind :knob :minimum 0.0 :maximum 127.0 :default 100.0 :unit :midi-velocity :output :midi-note
               :label "Part 2 velocity" :short-label "Vel" :show-label false :colour "0xE56B6F" :view-hook "addValueControl"}
  "velocity2" {:kind :knob :minimum 0.0 :maximum 127.0 :default 100.0 :unit :midi-velocity :output :midi-note
               :label "Part 3 velocity" :short-label "Vel" :show-label false :colour "0x76B947" :view-hook "addValueControl"}
  "velocity3" {:kind :knob :minimum 0.0 :maximum 127.0 :default 100.0 :unit :midi-velocity :output :midi-note
               :label "Part 4 velocity" :short-label "Vel" :show-label false :colour "0xC58BE8" :view-hook "addValueControl"}

  ;; Transport and view: one-off knobs, so they keep their labels.
  "controls" {:kind :box :fill "0xFFFFFF" :border "0xD9DCE1" :padding 8.0}
  "bpm" {:kind :knob :minimum 30.0 :maximum 240.0 :default 120.0 :unit :bpm :output :transport
         :label "BPM" :tooltip "Tempo. In a DAW the host tempo is used." :colour "0x5A616D" :view-hook "addValueControl"}
  "chordduration" {:kind :knob :minimum 1.0 :maximum 16.0 :default 4.0 :unit :duration :output :midi-note
                   :label "Chord length" :tooltip "Length of each chord, in beats." :colour "0x5A616D" :view-hook "addValueControl"}
  "zoom" {:kind :knob :minimum 1.0 :maximum 8.0 :default 1.0
          :label "Zoom" :tooltip "Piano-roll zoom." :colour "0x5A616D" :view-hook "addValueControl"}
  "reset" {:kind :button :label "Reset" :icon :reset :colour "0x3A3F48"}
  "pause" {:kind :toggle :label "Pause" :icon :pause :default false :colour "0x3A3F48"}
  "mute" {:kind :toggle :label "Mute output" :icon :mute :tooltip "Keep the score and transport running but suppress MIDI output." :default false :colour "0x3A3F48"}}}
