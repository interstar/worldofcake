{:generator-version 1
 :application {:id "timeslider"
               :package "timeslider"
               :generated-package "generated.timeslider"
               :composition-kind :timeslider
               :composition-class "TimeSliderCompositionGenerated"
               :layout-class "TimeSliderLayoutGenerated"}
 :geometry {:panel-width 800.0
            :panel-height 600.0
            :outer-padding 6.0
            :root-gap 6.0
            :nested-gap 6.0
            :gaps-by-depth {2 4.0}}
 :sequencer {:minimum-travel-time 120.0
             :maximum-travel-time 0.5}
 ;; Continuous controls the model publishes, one per lane (0..1). Hosts present each as a MIDI CC,
 ;; a VST parameter and Rack CV. Each lane's selectors change its MIDI channel and CC number at run time.
 :outputs [{:id "lane1" :label "Lane 1" :channel 1 :cc 1}
           {:id "lane2" :label "Lane 2" :channel 1 :cc 2}
           {:id "lane3" :label "Lane 3" :channel 1 :cc 3}
           {:id "lane4" :label "Lane 4" :channel 1 :cc 4}]
 :components
 {;; One lane per output: a label field above it, its MIDI channel and CC number below.
  "lane1label" {:kind :text-input :default "" :label "Lane 1 label" :tooltip "A name for what this lane controls; saved with the patch." :view-hook "addLabelInput"}
  "lane1track" {:kind :timeslider-track :colour "0x55B7D9" :channel-control "lane1channel" :cc-control "lane1cc" :label-control "lane1label"}
  "lane1channel" {:kind :semantic-select :label "Lane 1 MIDI channel" :tooltip "MIDI channel of this lane's CC messages."
                   :default-index 0 :presentation "compact" :view-hook "addChannelSelect" :choice-range {:from 1 :to 16 :format "Ch %d"}}
  "lane1cc" {:kind :semantic-select :label "Lane 1 CC number" :tooltip "CC number this lane sends. Click to step, or drag up and down."
              :default-index 1 :presentation "compact" :view-hook "addCcSelect" :choice-range {:from 0 :to 127 :format "CC %d"}}
  "lane2label" {:kind :text-input :default "" :label "Lane 2 label" :tooltip "A name for what this lane controls; saved with the patch." :view-hook "addLabelInput"}
  "lane2track" {:kind :timeslider-track :colour "0xE56B6F" :channel-control "lane2channel" :cc-control "lane2cc" :label-control "lane2label"}
