  "lane2cc" {:kind :semantic-select :label "Lane 2 CC number" :tooltip "CC number this lane sends. Click to step, or drag up and down."
              :default-index 2 :presentation "compact" :view-hook "addCcSelect" :choice-range {:from 0 :to 127 :format "CC %d"}}
  "lane3label" {:kind :text-input :default "" :label "Lane 3 label" :tooltip "A name for what this lane controls; saved with the patch." :view-hook "addLabelInput"}
  "lane3track" {:kind :timeslider-track :colour "0x76B947" :channel-control "lane3channel" :cc-control "lane3cc" :label-control "lane3label"}
  "lane3channel" {:kind :semantic-select :label "Lane 3 MIDI channel" :tooltip "MIDI channel of this lane's CC messages."
