  "lane3cc" {:kind :semantic-select :label "Lane 3 CC number" :tooltip "CC number this lane sends. Click to step, or drag up and down."
              :default-index 3 :presentation "compact" :view-hook "addCcSelect" :choice-range {:from 0 :to 127 :format "CC %d"}}
  "lane4label" {:kind :text-input :default "" :label "Lane 4 label" :tooltip "A name for what this lane controls; saved with the patch." :view-hook "addLabelInput"}
  "lane4track" {:kind :timeslider-track :colour "0xC58BE8" :channel-control "lane4channel" :cc-control "lane4cc" :label-control "lane4label"}
  "lane4channel" {:kind :semantic-select :label "Lane 4 MIDI channel" :tooltip "MIDI channel of this lane's CC messages."
