package kdiagram;

class KDiagramLayout {
    // Control panel virtual space (the entire window content)
    public static inline var PANEL_WIDTH:Int = 800;
    public static inline var PANEL_HEIGHT:Int = 600;
    
    // Window size (physical pixels)
    public static inline var WINDOW_WIDTH:Int = 800;
    public static inline var WINDOW_HEIGHT:Int = 600;
    
    // Play area
    public static inline var PLAY_AREA_X:Float = 20;
    public static inline var PLAY_AREA_Y:Float = 20;
    public static inline var PLAY_AREA_WIDTH:Float = 600;
    public static inline var PLAY_AREA_HEIGHT:Float = 600;
    
    // Speed sliders (to the right of play area)
    public static inline var SPEED_SLIDER_X1:Float = 640;
    public static inline var SPEED_SLIDER_X2:Float = 680;
    public static inline var SPEED_SLIDER_X3:Float = 720;
    public static inline var SPEED_SLIDER_Y:Float = 50;
    public static inline var SPEED_SLIDER_WIDTH:Float = 30;
    public static inline var SPEED_SLIDER_HEIGHT:Float = 150;
    
    // Channel slider
    public static inline var CHANNEL_SLIDER_X:Float = 640;
    public static inline var CHANNEL_SLIDER_Y:Float = 250;
    public static inline var CHANNEL_SLIDER_WIDTH:Float = 120;
    public static inline var CHANNEL_SLIDER_HEIGHT:Float = 30;
} 