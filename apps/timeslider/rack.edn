{;; Rack: 4 lanes, one CV output each. Rack draws its own panel (rack.layla, Rack's schema, below),
 ;; so this generator writes only the app's model code for this target.
 :model {:lanes 4}
 :generate-views false
 ;; Rack lanes are CV, not MIDI: no channel or CC selectors. Each lane keeps its label.
 :components {"lane{n}channel" nil
              "lane{n}cc" nil
              "lane{n}track" {:channel-control nil :cc-control nil}}
 :app :timeslider
 :target :vcvrack
 :application {:panel-svg "TimeSlider.svg"
               :title "GLR : Time Sliders"}
 :module {:slug "TimeSlider"
          :plugin "WorldOfCake-TimeSlider"
          :panel {:width-mm 132.08
                  :height-mm 128.5 :fill "#f1efea"}}
 :geometry {:panel-width 132.08 :panel-height 128.5
            :outer-padding 0.0 :root-gap 0.0 :nested-gap 0.0}
 ;; Panel text (title, captions, patch-bay labels) is outlined into the SVG by the generator.
 :rack-components {"title" {:kind :title :text "GLR : Time Sliders" :anchor :middle}
