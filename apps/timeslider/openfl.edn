{;; OpenFL (and, through juce.edn, the VST): 8 lanes, geometry and presentation.
 :model {:lanes 8}
 :geometry {:panel-width 1200.0
            :panel-height 600.0
            :outer-padding 6.0
            :root-gap 6.0
            :nested-gap 6.0
            :gaps-by-depth {2 4.0}}
 :components
 {"lane{n}label" {:view-hook "addLabelInput"}
  "lane{n}channel" {:presentation "compact" :view-hook "addChannelSelect"}
  "lane{n}cc" {:presentation "compact" :view-hook "addCcSelect"}

  "controls-gap" {:kind :spacer}
  "reset" {:icon :reset :colour "0x3A3F48"}
  "pause" {:icon :pause :colour "0x3A3F48"}}}
