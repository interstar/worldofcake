                       {:key :y :cpp-id "Y1_OUTPUT" :svg-label "Y1" :socket-mm {:x 189.5 :y 22.0} :config-label "Zewp 1 Y" :config-label-fragments ["Zewp " " Y"] :voltage-law :inverted-midi7-unipolar-10v}
