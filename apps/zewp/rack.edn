;; Rack: the model's code only (the panel below is Rack's schema, drawn by rack-layout-generate).
;; Panel text (title, headings, captions, patch-bay labels) is outlined into the SVG at build time.
{:generate-views false
 :app :zewp
 :target :vcvrack
 :application {:slug "Zewp" :panel-svg "Zewp.svg" :title "GLR : Zewp!"}
 :module {:slug "Zewp"
          :plugin "WorldOfCake-Zewp"
          :panel {:width-mm 243.84 :height-mm 128.5 :fill "#f1efea"}}
 :geometry {:panel-width 243.84 :panel-height 128.5 :outer-padding 0.0 :root-gap 0.0 :nested-gap 0.0}
 :rack-components
 {"title" {:kind :title :text "GLR : Zewp!" :anchor :middle}
  "playarea" {:kind :play-area}
  "patchbay" {:kind :patch-bay}
  "population-heading" {:kind :text :text "Zewps" :font-size-mm 2.4}
  "speed-heading" {:kind :text :text "Speed" :font-size-mm 2.4}
  "population" {:kind :knob :show-label false}
  "speed" {:kind :knob :show-label false}
  "reset" {:kind :button :label "Reset" :caption-position :below :font-size-mm 2.1}
  "pause" {:kind :toggle :label "Pause" :caption-position :below :font-size-mm 2.1}}
 ;; One group per output zewp, coloured as that zewp (the :zewps palette in app.edn).
